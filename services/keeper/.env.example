# Solana RPC endpoint the keeper subscribes to for Zebra program logs.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Base58 program ID of the deployed Zebra program (must match
# programs/zebra/src/lib.rs's declare_id! / Anchor.toml — the placeholder
# there is NOT a real deployment).
ZEBRA_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Where processed-signature dedupe state is persisted between restarts.
KEEPER_STATE_FILE=./keeper-state.json

# --- Zcash-side settings (see docs/ARCHITECTURE.md "Keeper trust model") ---
# Path to a zcash-cli binary connected to a synced zcashd/zebrad node whose
# wallet holds the funds this keeper pays out from. Leave unset to run the
# keeper in "detect-only" mode: it will log every burn-stamp it sees and
# exactly what it WOULD send, but will refuse to actually broadcast a
# payment (see zcashClient.ts). There is no default here on purpose — this
# keeper controls real funds once configured, and should never send by
# accident because an env var happened to be present.
ZCASH_CLI_PATH=
ZCASH_CLI_DATADIR=
ZCASH_CLI_RPCUSER=
ZCASH_CLI_RPCPASSWORD=
ZCASH_CLI_RPCPORT=8232

# Fixed conversion the keeper applies when turning `payout_zec` (a wZEC
# amount, base units matching wZEC's mint decimals) into a real ZEC amount
# to send. If wZEC is truly pegged 1:1 and shares ZEC's 8 decimals, this
# should be 1 — but this is exactly the custodial-peg trust assumption
# documented in docs/ARCHITECTURE.md, so it is a config value, not a
# hardcoded constant, in case the real wZEC deployment differs.
WZEC_TO_ZEC_RATE=1
WZEC_DECIMALS=8
